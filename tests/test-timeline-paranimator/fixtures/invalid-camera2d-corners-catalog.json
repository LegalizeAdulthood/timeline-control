{
  "parameter-catalogs": [
    "input/camera-corners-catalog.json"
  ],
  "source": {
    "file": "input/source.par",
    "name": "Corners_Demo"
  },
  "output": {
    "directory": "output",
    "par": "frames.par",
    "entry": "frame-%04d",
    "script": "frames.bat"
  },
  "video": "F6",
  "num-frames": 3,
  "tracks": [
    {
      "name": "camera",
      "type": "camera2d",
      "output": "center_mag",
      "aspect": "source",
      "look-at": {
        "type": "point2",
        "keys": [
          {
            "frame": 0,
            "value": "0/0"
          },
          {
            "frame": 2,
            "value": "1/1"
          }
        ]
      },
      "view-up": {
        "type": "vector2",
        "normalize": true,
        "keys": [
          {
            "frame": 0,
            "value": "0/2"
          },
          {
            "frame": 2,
            "value": "0/2"
          }
        ]
      },
      "height": {
        "type": "double",
        "keys": [
          {
            "frame": 0,
            "value": 4
          },
          {
            "frame": 2,
            "value": 2,
            "curve": "geometric"
          }
        ]
      }
    }
  ]
}
