{
  "parameter-catalogs": [ "input/core-catalog.json" ],
  "source": {
    "file": "input/source.par",
    "name": "Mandel_Demo"
  },
  "output": {
    "directory": "output",
    "par": "frames.par",
    "entry": "frame-%04d",
    "script": "frames.bat"
  },
  "video": "F6",
  "num-frames": 5,
  "tracks": [
    {
      "name": "camera",
      "type": "camera2d",
      "output": "center-mag",
      "aspect": "source",
      "look-at": {
        "type": "point2",
        "keys": [
          { "frame": 0, "value": "0/0" },
          { "frame": 4, "value": "0/0" }
        ]
      },
      "eye": {
        "type": "point2",
        "path": {
          "kind": "circle",
          "center": "0/0",
          "radius": 1,
          "turns": 1,
          "phase": 90
        }
      },
      "height": {
        "type": "double",
        "keys": [
          { "frame": 0, "value": 3 },
          { "frame": 4, "value": 3 }
        ]
      }
    }
  ]
}
