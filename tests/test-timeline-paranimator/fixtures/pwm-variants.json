{
  "parameter-catalogs": [ "input/core-catalog.json", "input/pwm-catalog.json" ],
  "source": { "file": "input/source.par", "name": "YesNo_Demo" },
  "output": {},
  "video": "F6",
  "num-frames": 8,
  "tracks": [
    { "parameter": "inside", "mode": "pwm", "a": "1", "b": "bof60", "window": 4,
      "keys": [ { "frame": 0, "mix": 0.5 }, { "frame": 7, "mix": 0.5 } ] },
    { "parameter": "showorbit", "mode": "pwm", "off": true, "on": false, "window": 2,
      "keys": [ { "frame": 0, "duty": 0.25 }, { "frame": 7, "duty": 0.25 } ] },
    { "parameter": "periodicity", "mode": "pwm", "a": "no", "b": "show", "window": 4,
      "keys": [ { "frame": 0, "mix": 0.0 }, { "frame": 7, "mix": 1.0 } ] },
    { "parameter": "showorbit", "mode": "pwm", "window": 3,
      "keys": [ { "frame": 0, "mix": 1.0 }, { "frame": 7, "mix": 0.0 } ] }
  ]
}
