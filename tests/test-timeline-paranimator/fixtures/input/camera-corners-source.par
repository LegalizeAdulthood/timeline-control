Rotated {
    reset type=mandel corners=-1/1/-3/3/-3/1
}

Reversed {
    reset type=mandel corners=3/-3/2/-2
}

BadArity {
    reset type=mandel corners=1/2/3
}

ZeroWidth {
    reset type=mandel corners=1/1/-2/2
}

ZeroHeight {
    reset type=mandel corners=-1/1/2/2
}

ZeroRotatedWidth {
    reset type=mandel corners=0/1/2/3/1/2
}

Missing {
    reset type=mandel center-mag=0/0/1
}
