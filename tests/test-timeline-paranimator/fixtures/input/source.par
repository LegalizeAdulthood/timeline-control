;
Mandel_Demo        { ; PAR for initialization of Fractint demo
   reset type=mandel center-mag=-0.5/0/1 params=0/0 inside=0
   sound=no maxiter=678
}

YesNo_Demo         { ; PAR for yes-no PWM test
   reset type=mandel center-mag=-0.5/0/1 params=0/0 inside=0
   showorbit=n sound=no maxiter=678
}

Julia_Demo         { ; PAR for initialization of Julia demo
   reset type=julia center-mag=-0.5/0/1 params=0/1 inside=0
   sound=no maxiter=678
}

Function_Demo      { ; PAR for function list tests
   reset type=formula formulaname=Larry function=sin/cos
   params=0.5/0/4/0 inside=0 sound=no maxiter=678
}

Corners_Demo       { ; PAR for corners interpolation test
   reset type=mandel corners=-3/-1/-2/2 params=0/0 inside=0
   sound=no maxiter=678
}

Bailout_Demo       { ; PAR for double interpolation test
   reset type=mandel center-mag=-0.5/0/1 params=0/0 inside=0
   bailout=1.25 sound=no maxiter=678
}

Julibrot_Demo      { ; PAR for Julibrot camera adapter test
   reset type=julibrot 3dmode=monocular julibrot3d=128/8/8/7/10/24
   sound=no maxiter=678
}
