{
  "parameters": {
    "maxiter": { "type": "integer", "description": "Iterations", "default-curve": "linear" },
    "label": { "type": "string", "description": "Text", "default-curve": "hold" },
    "complex": { "type": "point2", "description": "Two-component value", "default-curve": "linear" },
    "center-mag": { "type": "center-mag", "description": "Center and magnification" },
    "corners": { "type": "corners", "description": "Corners" },
    "showorbit": { "type": "yes-no", "description": "Orbits", "default-curve": "hold" },
    "function": { "type": "function-list", "description": "Functions", "values": "id-functions", "default-curve": "hold" },
    "functions": { "type": "function-list", "description": "Function list", "values": "id-functions", "default-curve": "hold" }
