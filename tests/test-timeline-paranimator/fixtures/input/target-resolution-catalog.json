  },
  "formula-entries": {
    "Larry": {
      "params": {
        "knobs": {
          "c": { "type": "complex", "description": "Constant", "variable": "p1", "default-curve": "linear" },
          "amount": { "type": "real", "description": "Amount", "variable": "p2.real", "default-curve": "linear" }
        }
      },
      "functions": { "fn2": { "type": "enum", "description": "Second function", "values": "id-functions" } }
    }
  }
