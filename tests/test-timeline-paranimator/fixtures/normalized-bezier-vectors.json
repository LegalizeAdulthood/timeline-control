    { "parameter": "raw3", "path": { "kind": "bezier", "control-points": [ "0/0/2", "2/0/2", "2/2/2", "0/2/2" ] } },
    { "parameter": "tiny2", "path": { "kind": "bezier", "control-points": [ "5e-13/2e-12", "5e-13/2e-12" ] } },
    { "parameter": "hull2", "path": { "kind": "bezier", "control-points": [ "1/0", "0/0", "0/1" ] } }
  ]
