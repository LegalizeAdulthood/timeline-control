{
  "parameter-catalogs": [ "input/core-catalog.json" ],
  "source": {
    "file": "input/source.par",
    "name": "Mandel_Demo"
  },
  "output": {
    "directory": "output",
    "par": "frames.par",
    "entry": "frame-%04d",
    "script": "frames.bat"
  },
  "video": "F6",
  "num-frames": 3,
  "tracks": [
    {
      "name": "camera",
      "type": "camera2d",
      "output": "center-mag",
      "aspect": "source",
      "look-at": {
        "type": "point2",
        "keys": [
          { "frame": 0, "value": "-0.5/0" },
          { "frame": 2, "value": "-0.25/0.5" }
        ]
      },
      "view-up": {
        "type": "vector2",
        "normalize": true,
        "keys": [
          { "frame": 0, "value": "0/1" },
          { "frame": 2, "value": "0/1" }
        ]
      },
      "height": {
        "type": "double",
        "keys": [
          { "frame": 0, "value": 3 },
          { "frame": 2, "value": 1.5, "curve": "geometric" }
        ]
      }
    }
  ]
}
