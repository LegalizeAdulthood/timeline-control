{
  "parameter-catalogs": ["input/id-3d-catalog.json"],
  "source": {"file": "input/source.par", "name": "Mandel_Demo"},
  "output": {
    "directory": "output", "par": "frames.par",
    "entry": "frame-%04d", "script": "frames.bat"
  },
  "video": "F6",
  "num-frames": 3,
  "tracks": [
    {
      "name": "rolled-endpoint", "type": "id-3d-view",
      "outputs": {"rotation": "rotation"},
      "camera3d": {
        "eye": {"type": "point3", "keys": [
          {"frame": 0, "value": "0/10/5"},
          {"frame": 2, "value": "-6/5/8", "curve": "hold"}
        ]},
        "look-at": {"type": "point3", "keys": [
          {"frame": 0, "value": "0/0/0"},
          {"frame": 2, "value": "0/0/0"}
        ]},
        "view-up": {"type": "vector3", "keys": [
          {"frame": 0, "value": "0/-1/-3"},
          {"frame": 2, "value": "-0.6/2/0.9", "curve": "step"}
        ]}
      }
    },
    {
      "name": "vertical-endpoint", "type": "id-3d-view",
      "outputs": {"rotation": "rotation"},
      "camera3d": {
        "eye": {"type": "point3", "keys": [
          {"frame": 0, "value": "0/10/5"},
          {"frame": 2, "value": "0/5/0", "curve": "step"}
        ]},
        "look-at": {"type": "point3", "keys": [
          {"frame": 0, "value": "0/0/0"},
          {"frame": 2, "value": "0/0/0"}
        ]},
        "view-up": {"type": "vector3", "keys": [
          {"frame": 0, "value": "0/-1/-3"},
          {"frame": 2, "value": "0/0/-1", "curve": "hold"}
        ]}
      }
    },
    {
      "name": "singular-endpoint", "type": "id-3d-view",
      "outputs": {"rotation": "rotation"},
      "camera3d": {
        "eye": {"type": "point3", "keys": [
          {"frame": 0, "value": "0/10/5"},
          {"frame": 2, "value": "0/0/0", "curve": "hold"}
        ]},
        "look-at": {"type": "point3", "keys": [
          {"frame": 0, "value": "0/0/0"},
          {"frame": 2, "value": "0/0/0"}
        ]},
        "view-up": {"type": "vector3", "keys": [
          {"frame": 0, "value": "0/-1/-3"},
          {"frame": 2, "value": "0/1/0", "curve": "step"}
        ]}
      }
    },
    {
      "name": "linear-eye-held-up", "type": "id-3d-view",
      "outputs": {"rotation": "rotation"},
      "camera3d": {
        "eye": {"type": "point3", "keys": [
          {"frame": 0, "value": "0/10/5"},
          {"frame": 2, "value": "-6/5/8"}
        ]},
        "look-at": {"type": "point3", "keys": [
          {"frame": 0, "value": "0/0/0"},
          {"frame": 2, "value": "0/0/0"}
        ]},
        "view-up": {"type": "vector3", "keys": [
          {"frame": 0, "value": "0/-1/-3"},
          {"frame": 2, "value": "-0.6/2/0.8", "curve": "hold"}
        ]}
      }
    },
    {
      "name": "held-eye-linear-up", "type": "id-3d-view",
      "outputs": {"rotation": "rotation"},
      "camera3d": {
        "eye": {"type": "point3", "keys": [
          {"frame": 0, "value": "0/10/5"},
          {"frame": 2, "value": "-6/5/8", "curve": "step"}
        ]},
        "look-at": {"type": "point3", "keys": [
          {"frame": 0, "value": "0/0/0"},
          {"frame": 2, "value": "0/0/0"}
        ]},
        "view-up": {"type": "vector3", "keys": [
          {"frame": 0, "value": "0/-1/-3"},
          {"frame": 2, "value": "-0.6/2/0.8"}
        ]}
      }
    }
  ]
}
