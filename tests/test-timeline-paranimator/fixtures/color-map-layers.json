            }
          ]
        }
      ]
    },
    {
      "id": "constant",
      "source": {
        "file": "input/source.par",
        "name": "Mandel_Demo"
      },
      "tracks": [
        {
          "parameter": "colors",
          "type": "color-map",
          "format": "at-file",
          "output": "gradient-%04d.map",
          "source": "input/warm.map"
        }
      ]
    }
  ]
