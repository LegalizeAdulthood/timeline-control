{
  "parameter-catalogs": ["input/julibrot-catalog.json"],
  "source": {"file": "input/source.par", "name": "Julibrot_Demo"},
  "output": {"directory": "output", "par": "frames.par", "entry": "frame-%04d", "script": "frames.bat"},
  "video": "F6", "num-frames": 3,
  "tracks": [
    {"name": "look boundary", "type": "julibrot-view", "outputs": {"geometry": "julibrot3d"},
     "camera3d": {
       "eye": {"type": "point3", "keys": [{"frame": 0, "value": "0/0/1"}, {"frame": 2, "value": "0/0/1"}]},
       "look-at": {"type": "point3", "keys": [{"frame": 0, "value": "1e-9/0/0"}, {"frame": 2, "value": "1e-9/0/0"}]},
       "view-up": {"type": "vector3", "normalize": true, "keys": [{"frame": 0, "value": "0/1/0"}, {"frame": 2, "value": "0/1/0"}]}}},
    {"name": "forward x boundary", "type": "julibrot-view", "outputs": {"geometry": "julibrot3d"},
     "camera3d": {
       "eye": {"type": "point3", "keys": [{"frame": 0, "value": "1e-9/0/1"}, {"frame": 2, "value": "1e-9/0/1"}]},
       "look-at": {"type": "point3", "keys": [{"frame": 0, "value": "0/0/0"}, {"frame": 2, "value": "0/0/0"}]},
       "view-up": {"type": "vector3", "normalize": true, "keys": [{"frame": 0, "value": "0/1/0"}, {"frame": 2, "value": "0/1/0"}]}}},
    {"name": "forward y boundary", "type": "julibrot-view", "outputs": {"geometry": "julibrot3d"},
     "camera3d": {
       "eye": {"type": "point3", "keys": [{"frame": 0, "value": "0/-1e-9/1"}, {"frame": 2, "value": "0/-1e-9/1"}]},
       "look-at": {"type": "point3", "keys": [{"frame": 0, "value": "0/0/0"}, {"frame": 2, "value": "0/0/0"}]},
       "view-up": {"type": "vector3", "normalize": true, "keys": [{"frame": 0, "value": "0/1/0"}, {"frame": 2, "value": "0/1/0"}]}}},
    {"name": "up boundary", "type": "julibrot-view", "outputs": {"geometry": "julibrot3d"},
     "camera3d": {
       "eye": {"type": "point3", "keys": [{"frame": 0, "value": "0/0/1"}, {"frame": 2, "value": "0/0/1"}]},
       "look-at": {"type": "point3", "keys": [{"frame": 0, "value": "0/0/0"}, {"frame": 2, "value": "0/0/0"}]},
       "view-up": {"type": "vector3", "normalize": true, "keys": [{"frame": 0, "value": "1e-9/1/0"}, {"frame": 2, "value": "1e-9/1/0"}]}}},
    {"name": "held invalid endpoint", "type": "julibrot-view", "outputs": {"geometry": "julibrot3d"},
     "camera3d": {
       "eye": {"type": "point3", "keys": [{"frame": 0, "value": "0/0/1"}, {"frame": 2, "value": "0/0/1", "curve": "hold"}]},
       "look-at": {"type": "point3", "keys": [{"frame": 0, "value": "0/0/0"}, {"frame": 2, "value": "0/0/0"}]},
       "view-up": {"type": "vector3", "normalize": true, "keys": [{"frame": 0, "value": "0/1/0"}, {"frame": 2, "value": "1e-9/1/0", "curve": "step"}]}}},
    {"name": "off-grid forward cleanup", "type": "julibrot-view", "outputs": {"geometry": "julibrot3d"},
     "camera3d": {
       "eye": {"type": "point3", "keys": [{"frame": 0, "value": "5e-13/0/1e-5"}, {"frame": 2, "value": "2e-12/0/.0025"}]},
       "look-at": {"type": "point3", "keys": [{"frame": 0, "value": "0/0/0"}, {"frame": 2, "value": "0/0/0"}]},
       "view-up": {"type": "vector3", "normalize": true, "keys": [{"frame": 0, "value": "0/1/0"}, {"frame": 2, "value": "0/1/0"}]}}},
    {"name": "off-grid camera up", "type": "julibrot-view", "outputs": {"geometry": "julibrot3d"},
     "camera3d": {
       "eye": {"type": "point3", "keys": [{"frame": 0, "value": "0/0/1"}, {"frame": 2, "value": "-6e-10/0/1"}]},
       "look-at": {"type": "point3", "keys": [{"frame": 0, "value": "0/0/0"}, {"frame": 2, "value": "0/0/0"}]},
       "view-up": {"type": "vector3", "normalize": true, "keys": [{"frame": 0, "value": "0/1/4"}, {"frame": 2, "value": "-6e-10/.01/1"}]}}}
  ]
}
