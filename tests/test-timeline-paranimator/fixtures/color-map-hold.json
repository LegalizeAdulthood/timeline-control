{
  "parameter-catalogs": [
    "input/core-catalog.json"
  ],
  "source": {
    "file": "input/source.par",
    "name": "Mandel_Demo"
  },
  "output": {
    "directory": "output",
    "par": "frames.par",
    "entry": "frame-%04d",
    "script": "frames.bat"
  },
  "video": "F6",
  "num-frames": 3,
  "tracks": [
    {
      "parameter": "colors",
      "type": "color-map",
      "format": "at-file",
      "output": "colors-%04d.map",
      "keys": [
        {
          "frame": 0,
          "value": "input/warm.map"
        },
        {
          "frame": 2,
          "value": "input/cool.map",
          "curve": "step"
        }
      ]
    }
  ]
}
