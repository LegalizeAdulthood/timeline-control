{
  "parameter-catalogs": [
    "input/camera-corners-catalog.json"
  ],
  "source": {
    "file": "input/source.par",
    "name": "Corners_Demo"
  },
  "output": {
    "directory": "output",
    "par": "frames.par",
    "entry": "frame-%04d",
    "script": "frames.bat"
  },
  "video": "F6",
  "num-frames": 5,
  "tracks": [
    {
      "name": "nested-eye-zero",
      "type": "camera2d",
      "output": "corners",
      "aspect": "source",
      "look-at": {
        "type": "point2",
        "keys": [
          {
            "frame": 0,
            "value": "0/0",
            "curve": "linear"
          },
          {
            "frame": 4,
            "value": "1/0",
            "curve": "linear"
          }
        ]
      },
      "eye": {
        "type": "point2",
        "path": {
          "kind": "bezier",
          "control-points": [
            "-2/1",
            "2/-1",
            "2/2"
          ]
        }
      },
      "view-up": {
        "type": "vector2",
        "keys": [
          {
            "frame": 0,
            "value": "0/0",
            "curve": "linear"
          },
          {
            "frame": 4,
            "value": "0/0",
            "curve": "linear"
          }
        ],
        "normalize": true
      },
      "height": {
        "type": "double",
        "keys": [
          {
            "frame": 0,
            "value": 2,
            "curve": "linear"
          },
          {
            "frame": 4,
            "value": 4,
            "curve": "linear"
          }
        ]
      },
      "skew": {
        "type": "double",
        "keys": [
          {
            "frame": 0,
            "value": -10
          },
          {
            "frame": 4,
            "value": -40,
            "curve": "geometric"
          }
        ]
      }
    }
  ]
}
