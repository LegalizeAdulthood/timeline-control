{
  "$schema": "https://github.com/microsoft/vcpkg-tool/blob/3bc494764599acf9e431accdae1ac00a4dd0faa1/docs/vcpkg.schema.json",
  "name": "timeline-control",
  "description": "Sample code for the Utah C++ Programmers video Timeline Control",
  "version-semver": "1.0.0",
  "dependencies": [
    "gtest",
    "nlohmann-json"
  ],
  "features": {
    "imgui": {
      "description": "Build the Dear ImGui timeline control",
      "dependencies": [
        {
          "name": "imgui",
          "default-features": false,
          "features": [ "sdl3-binding", "sdl3-renderer-binding" ]
        }
      ]
    },
    "wx": {
      "description": "Build the wxWidgets timeline control",
      "dependencies": [
        {
          "name": "wxwidgets",
          "default-features": false
        }
      ]
    }
  }
}
